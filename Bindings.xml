<Bindings>
	<Binding name="NETHERBAGS_TOGGLE" header="NETHERBAGS" category="ADDONS">
		NetherBags:Toggle("bags")
	</Binding>
	<Binding name="NETHERBAGS_BANK" category="ADDONS">
		NetherBags:Toggle("bank")
	</Binding>
	<Binding name="NETHERBAGS_EVERYWHERE" category="ADDONS">
		NetherBags:Open("bags", "everywhere")
	</Binding>
	<Binding name="NETHERBAGS_MODE" category="ADDONS">
		NetherBags:ToggleMode()
	</Binding>
	<Binding name="CLICK NetherBagsQuestItem1:LeftButton" category="ADDONS"/>
	<Binding name="CLICK NetherBagsQuestItem2:LeftButton" category="ADDONS"/>
	<Binding name="CLICK NetherBagsQuestItem3:LeftButton" category="ADDONS"/>
	<Binding name="CLICK NetherBagsQuestItem4:LeftButton" category="ADDONS"/>
</Bindings>
